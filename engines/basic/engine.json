{
  "abi": "shogihome-wasm-engine/2",
  "module": "basic.js",
  "moduleFormat": "esm",
  "name": "ShogiHome 3-Ply Engine",
  "author": "Kubo, Ryosuke",
  "options": [
    {
      "name": "Style",
      "type": "combo",
      "default": "static_rook",
      "vars": ["static_rook", "ranging_rook", "random"]
    },
    {
      "name": "Depth",
      "type": "spin",
      "default": 3,
      "min": 1,
      "max": 5
    },
    {
      "name": "MinimumThinkingTime",
      "type": "spin",
      "default": 500,
      "min": 0,
      "max": 60000
    },
    {
      "name": "Randomize",
      "type": "check",
      "default": "true"
    },
    {
      "name": "USI_Ponder",
      "type": "check",
      "default": "false"
    }
  ],
  "presets": [
    {
      "id": "basic-3ply-static-rook-v1",
      "displayName": "ShogiHome 3-Ply (Static Rook)",
      "values": { "Style": "static_rook", "Depth": 3 }
    },
    {
      "id": "basic-3ply-ranging-rook-v1",
      "displayName": "ShogiHome 3-Ply (Ranging Rook)",
      "values": { "Style": "ranging_rook", "Depth": 3 }
    },
    {
      "id": "basic-5ply-static-rook-v1",
      "displayName": "ShogiHome 5-Ply (Static Rook)",
      "values": { "Style": "static_rook", "Depth": 5 }
    },
    {
      "id": "basic-5ply-ranging-rook-v1",
      "displayName": "ShogiHome 5-Ply (Ranging Rook)",
      "values": { "Style": "ranging_rook", "Depth": 5 }
    }
  ]
}
