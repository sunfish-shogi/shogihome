#!/bin/bash -eu
set -o pipefail

DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
COMMAND_DIR=$DIR/..
COMMAND=$COMMAND_DIR/index.js
MOCK_DIR=$DIR/mock
SCENARIO_DIR=$DIR/scenario/$1

if [ ! -d $SCENARIO_DIR ]; then
  echo "Scenario $1 not found"
  exit 1
fi

if [ ! -f $COMMAND ]; then
  echo "Command $COMMAND not found"
  exit 1
fi

# モックサーバーが待ち受けを開始する前にブリッジが接続すると ECONNREFUSED となるため、
# 待ち受けの開始を知らせるファイルが作られるまで待つ。
READY_FILE="$(mktemp)"
rm -f "$READY_FILE"
trap 'rm -f "$READY_FILE"' EXIT

READY_FILE=$READY_FILE npx --no-install tsx $MOCK_DIR/csa-replay-server.ts $SCENARIO_DIR/csa.log &
MOCK_PID=$!

for _ in $(seq 300); do
  if [ -e "$READY_FILE" ]; then
    break
  fi
  if ! kill -0 $MOCK_PID 2>/dev/null; then
    echo "Mock server exited before listening"
    exit 1
  fi
  sleep 0.1
done

if [ ! -e "$READY_FILE" ]; then
  echo "Mock server did not start listening"
  exit 1
fi

node $COMMAND --all-log-file $SCENARIO_DIR/bridge-config.yaml
wait

$SCENARIO_DIR/verify-record