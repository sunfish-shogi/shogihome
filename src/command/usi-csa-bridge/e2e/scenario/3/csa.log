# 入玉宣言勝ち (%KACHI / #JISHOGI / #WIN) のシナリオ。
# エンジンが bestmove win を返し、ブリッジが %KACHI を送信する経路を検証する。
# 開始局面は後手が宣言条件 (敵陣に玉、玉を除き 12 枚、28 点) を満たしている。
recv:LOGIN usi-csa-bridge test
send:LOGIN:usi-csa-bridge OK
send:BEGIN Game_Summary
send:Protocol_Version:1.2
send:Protocol_Mode:Server
send:Format:Shogi 1.0
send:Declaration:Jishogi 1.1
send:Game_ID:test+test-30-5F+Enemy+usi-csa-bridge+20260805000300
send:Name+:Enemy
send:Name-:usi-csa-bridge
send:Your_Turn:-
send:Rematch_On_Draw:NO
send:To_Move:-
send:Max_Moves:256
send:BEGIN Time
send:Time_Unit:1sec
send:Total_Time:30
send:Byoyomi:0
send:Increment:5
send:Least_Time_Per_Move:0
send:END Time
send:BEGIN Position
send:P1 *  *  *  * +OU *  *  *  *
send:P2 *  *  *  *  *  *  *  *  *
send:P3 *  *  *  *  *  *  *  *  *
send:P4 *  *  *  *  *  *  *  *  *
send:P5 *  *  *  *  *  *  *  *  *
send:P6 *  *  *  *  *  *  *  *  *
send:P7-RY-UM-KI-KI-KI-KI-UM-RY *
send:P8-GI-GI-GI-GI-OU *  *  *  *
send:P9 *  *  *  *  *  *  *  *  *
send:P+
send:P-
send:-
send:END Position
send:END Game_Summary
recv:AGREE test+test-30-5F+Enemy+usi-csa-bridge+20260805000300
send:START:test+test-30-5F+Enemy+usi-csa-bridge+20260805000300
# エンジンが勝利宣言を選択する
recv:%KACHI
send:%KACHI,T8
send:#JISHOGI
send:#WIN
