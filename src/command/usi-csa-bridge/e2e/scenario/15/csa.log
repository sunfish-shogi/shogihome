# 残り時間を超える消費時間が通知された場合のシナリオ。
# 仕様上、持時間と秒読みの両方がある場合は残り時間より多くの消費時間が
# 付与されることがあり、クライアントは残り時間を 0 として扱う。
recv:LOGIN usi-csa-bridge test
send:LOGIN:usi-csa-bridge OK
send:BEGIN Game_Summary
send:Protocol_Version:1.2
send:Protocol_Mode:Server
send:Format:Shogi 1.0
send:Declaration:Jishogi 1.1
send:Game_ID:test+test-30-5F+Enemy+usi-csa-bridge+20260805001500
send:Name+:Enemy
send:Name-:usi-csa-bridge
send:Your_Turn:-
send:Rematch_On_Draw:NO
send:To_Move:+
send:Max_Moves:256
send:BEGIN Time
send:Time_Unit:1sec
send:Total_Time:10
send:Byoyomi:30
send:END Time
send:BEGIN Position
send:P1-KY-KE-GI-KI-OU-KI-GI-KE-KY
send:P2 * -HI *  *  *  *  * -KA *
send:P3-FU-FU-FU-FU-FU-FU-FU-FU-FU
send:P4 *  *  *  *  *  *  *  *  *
send:P5 *  *  *  *  *  *  *  *  *
send:P6 *  *  *  *  *  *  *  *  *
send:P7+FU+FU+FU+FU+FU+FU+FU+FU+FU
send:P8 * +KA *  *  *  *  * +HI *
send:P9+KY+KE+GI+KI+OU+KI+GI+KE+KY
send:+
send:END Position
send:END Game_Summary
recv:AGREE test+test-30-5F+Enemy+usi-csa-bridge+20260805001500
send:START:test+test-30-5F+Enemy+usi-csa-bridge+20260805001500
send:+2726FU,T3
recv:-8384FU
send:-8384FU,T2
send:+2625FU,T5
recv:-8485FU
send:-8485FU,T3
# 相手が残り時間 (2 秒) を超える 25 秒を消費し、秒読みの時間帯に入る
send:+6978KI,T25
recv:-3334FU
send:-3334FU,T1
# 相手が秒読みを使い切って時間切れとなる
send:#TIME_UP
send:#WIN
