# CSA プロトコル v1.2.1 の標準的な運用 (protocolVersion: v121) のシナリオ。
# エンジンは評価値と読み筋を返すが、Floodgate 拡張ではないため
# 指し手に評価値・読み筋を付与しないことを検証する。
# また、v121 では対局終了後に LOGOUT を送信して LOGOUT:completed を待つ。
recv:LOGIN usi-csa-bridge test
send:LOGIN:usi-csa-bridge OK
send:BEGIN Game_Summary
send:Protocol_Version:1.2
send:Protocol_Mode:Server
send:Format:Shogi 1.0
send:Declaration:Jishogi 1.1
send:Game_ID:test+test-30-5F+Enemy+usi-csa-bridge+20260805002000
send:Name+:Enemy
send:Name-:usi-csa-bridge
send:Your_Turn:-
send:Rematch_On_Draw:NO
send:To_Move:+
send:Max_Moves:256
send:BEGIN Time
send:Time_Unit:1sec
send:Total_Time:30
send:Byoyomi:0
send:Increment:5
send:Least_Time_Per_Move:0
send:END Time
send:BEGIN Position
send:P1-KY-KE-GI-KI-OU-KI-GI-KE-KY
send:P2 * -HI *  *  *  *  * -KA *
send:P3-FU-FU-FU-FU-FU-FU-FU-FU-FU
send:P4 *  *  *  *  *  *  *  *  *
send:P5 *  *  *  *  *  *  *  *  *
send:P6 *  *  *  *  *  *  *  *  *
send:P7+FU+FU+FU+FU+FU+FU+FU+FU+FU
send:P8 * +KA *  *  *  *  * +HI *
send:P9+KY+KE+GI+KI+OU+KI+GI+KE+KY
send:+
send:END Position
send:END Game_Summary
recv:AGREE test+test-30-5F+Enemy+usi-csa-bridge+20260805002000
send:START:test+test-30-5F+Enemy+usi-csa-bridge+20260805002000
send:+2726FU,T2
recv:-8384FU
send:-8384FU,T1
send:+2625FU,T2
recv:-8485FU
send:-8485FU,T1
send:+6978KI,T3
recv:-3334FU
send:-3334FU,T1
send:%TORYO,T2
send:#RESIGN
send:#WIN
# v121 では対局待ち状態に戻った後に LOGOUT を送信する
recv:LOGOUT
send:LOGOUT:completed
