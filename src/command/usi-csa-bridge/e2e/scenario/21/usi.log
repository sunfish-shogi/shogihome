recv:usi
send:id name USI Replay Engine
send:id author ShogiHome
send:option name USI_Hash type spin default 32 min 1 max 4096
send:option name USI_Ponder type check default true
send:option name BookFile type string default standard_book.db
send:option name EvalDir type filename default eval
send:option name BookMoveSelector type combo default default var default var random
send:option name ClearHash type button
send:usiok
recv:setoption name USI_Hash value 32
recv:setoption name USI_Ponder value false
recv:setoption name BookFile value standard_book.db
recv:setoption name EvalDir value eval
recv:setoption name BookMoveSelector value default
recv:isready
send:readyok
recv:usinewgame
