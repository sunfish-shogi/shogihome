# 早期 Ponder (enableEarlyPonder) のシナリオ。
# 自分は後手。相手の応手が Ponder の予想と一致するケース (ponderhit) と
# 一致しないケース (ponder miss) の両方を含む。
recv:LOGIN usi-csa-bridge test
send:LOGIN:usi-csa-bridge OK
send:BEGIN Game_Summary
send:Protocol_Version:1.2
send:Protocol_Mode:Server
send:Format:Shogi 1.0
send:Declaration:Jishogi 1.1
send:Game_ID:test+test-30-5F+Enemy+usi-csa-bridge+20260723000000
send:Name+:Enemy
send:Name-:usi-csa-bridge
send:Your_Turn:-
send:Rematch_On_Draw:NO
send:To_Move:+
send:Max_Moves:256
send:BEGIN Time
send:Time_Unit:1sec
send:Total_Time:30
send:Byoyomi:0
send:Increment:5
send:Least_Time_Per_Move:0
send:END Time
send:BEGIN Position
send:P1-KY-KE-GI-KI-OU-KI-GI-KE-KY
send:P2 * -HI *  *  *  *  * -KA *
send:P3-FU-FU-FU-FU-FU-FU-FU-FU-FU
send:P4 *  *  *  *  *  *  *  *  *
send:P5 *  *  *  *  *  *  *  *  *
send:P6 *  *  *  *  *  *  *  *  *
send:P7+FU+FU+FU+FU+FU+FU+FU+FU+FU
send:P8 * +KA *  *  *  *  * +HI *
send:P9+KY+KE+GI+KI+OU+KI+GI+KE+KY
send:+
send:END Position
send:END Game_Summary
recv:AGREE test+test-30-5F+Enemy+usi-csa-bridge+20260723000000
send:START:test+test-30-5F+Enemy+usi-csa-bridge+20260723000000
send:+2726FU,T2
recv:-8384FU
send:-8384FU,T1
# 相手が Ponder の予想 (2f2e) と同じ手を指す → ponderhit
send:+2625FU,T2
recv:-8485FU
send:-8485FU,T1
# 相手が Ponder の予想 (7g7f) と違う手を指す → ponder miss
send:+6978KI,T3
recv:-3334FU
send:-3334FU,T1
# 早期 Ponder 中に相手が投了する
send:%TORYO,T3
send:#RESIGN
send:#WIN
