# 入玉宣言が条件を満たさない場合 (%KACHI / #ILLEGAL_MOVE / #LOSE) のシナリオ。
# 仕様により、条件を満たさない勝利宣言は不正な着手として扱われる。
# %KACHI は棋譜に追加されないため、終局時の手番は自分側に残る。
recv:LOGIN usi-csa-bridge test
send:LOGIN:usi-csa-bridge OK
send:BEGIN Game_Summary
send:Protocol_Version:1.2
send:Protocol_Mode:Server
send:Format:Shogi 1.0
send:Declaration:Jishogi 1.1
send:Game_ID:test+test-30-5F+Enemy+usi-csa-bridge+20260805000400
send:Name+:Enemy
send:Name-:usi-csa-bridge
send:Your_Turn:-
send:Rematch_On_Draw:NO
send:To_Move:-
send:Max_Moves:256
send:BEGIN Time
send:Time_Unit:1sec
send:Total_Time:30
send:Byoyomi:0
send:Increment:5
send:Least_Time_Per_Move:0
send:END Time
send:BEGIN Position
send:P1 *  *  *  * +OU *  *  *  *
send:P2 *  *  *  *  *  *  *  *  *
send:P3 *  *  *  *  *  *  *  *  *
send:P4 *  *  *  *  *  *  *  *  *
send:P5 *  *  *  *  *  *  *  *  *
send:P6 *  *  *  *  *  *  *  *  *
send:P7 *  *  *  *  *  *  *  *  *
send:P8 *  *  *  * -OU *  *  *  *
send:P9 *  *  *  *  *  *  *  *  *
send:P+
send:P-
send:-
send:END Position
send:END Game_Summary
recv:AGREE test+test-30-5F+Enemy+usi-csa-bridge+20260805000400
send:START:test+test-30-5F+Enemy+usi-csa-bridge+20260805000400
# 宣言条件を満たしていないため反則負けとなる
recv:%KACHI
send:%KACHI,T8
send:#ILLEGAL_MOVE
send:#LOSE
