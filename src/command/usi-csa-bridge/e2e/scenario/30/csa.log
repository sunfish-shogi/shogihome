send:Name+:usi-csa-bridge
send:Name-:Enemy
send:Your_Turn:+
send:Rematch_On_Draw:NO
send:To_Move:+
send:Max_Moves:256
send:BEGIN Time
send:Time_Unit:1sec
send:Total_Time:30
send:Byoyomi:0
send:Increment:5
send:Least_Time_Per_Move:0
send:END Time
send:BEGIN Position
send:P1-KY-KE-GI-KI-OU-KI-GI-KE-KY
send:P2 * -HI *  *  *  *  * -KA *
send:P3-FU-FU-FU-FU-FU-FU-FU-FU-FU
