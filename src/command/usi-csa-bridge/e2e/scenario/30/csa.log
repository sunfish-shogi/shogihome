recv:AGREE test+test-30-5F+Enemy+usi-csa-bridge+20260805003000
send:START:test+test-30-5F+Enemy+usi-csa-bridge+20260805003000
recv:+2726FU
send:+2726FU,T1
# 相手が Ponder の予想 (8c8d) と同じ手を指す → ponderhit
send:-8384FU,T2
recv:+2625FU
send:+2625FU,T1
# 相手が Ponder の予想 (8d8e) と違う手を指す → ponder miss
send:-3334FU,T2
recv:+6978KI
